---
interface Props {
  id: string
  index: string
  eyebrow: string
  title: string
  intro?: string
  class?: string
}
const { id, index, eyebrow, title, intro, class: className = "" } = Astro.props
---

<section id={id} class={`mx-auto w-full max-w-5xl scroll-mt-24 px-4 py-20 md:py-28 ${className}`}>
  <header class="reveal mb-12 max-w-2xl">
    <p class="mb-3 flex items-center gap-3 font-mono text-xs uppercase tracking-[0.2em] text-muted">
      <span class="text-accent">{index}</span>
      <span class="h-px w-8 bg-line/20"></span>
      {eyebrow}
    </p>
    <h2 data-split class="text-3xl font-semibold tracking-[-0.03em] md:text-5xl" set:html={title} />
    {intro && <p class="mt-4 text-lg text-muted">{intro}</p>}
  </header>
  <slot />
</section>
