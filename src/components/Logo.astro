---
// Logo de gerysdev: una G trazada como un hexágono (arquitectura hexagonal) cuya barra
// conecta con el núcleo del dominio, como un servicio enlazado al centro del sistema.
interface Props {
  class?: string
}
const { class: className = "size-8" } = Astro.props
const id = `logo-g-${Math.random().toString(36).slice(2, 8)}`
---

<svg class={className} viewBox="0 0 64 64" aria-hidden="true">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fcd34d" />
      <stop offset="1" stop-color="#fb853c" />
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="16" fill="#111113" />
  <path d="M44.5 19.4 32 12 14.7 22v20L32 52l17.3-10V32H36" fill="none" stroke={`url(#${id})`} stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
  <circle cx="32" cy="32" r="5" fill="#eeeef0" class="transition-transform duration-300 [transform-box:fill-box] [transform-origin:center] group-hover:scale-125" />
</svg>
