---
// Logo de gerysdev: hexágono (arquitectura hexagonal) con el núcleo del dominio en el centro.
interface Props {
  class?: string
}
const { class: className = "size-8" } = Astro.props
const id = `logo-g-${Math.random().toString(36).slice(2, 8)}`
---

<svg class={className} viewBox="0 0 64 64" aria-hidden="true">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fcd34d" />
      <stop offset="1" stop-color="#fb853c" />
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="16" fill="#111113" />
  <path d="M32 12 49.3 22v20L32 52 14.7 42V22Z" fill="none" stroke={`url(#${id})`} stroke-width="4.5" stroke-linejoin="round" class="transition-transform duration-500 [transform-box:fill-box] [transform-origin:center] group-hover:rotate-[60deg]" />
  <circle cx="32" cy="32" r="6.5" fill={`url(#${id})`} />
</svg>
