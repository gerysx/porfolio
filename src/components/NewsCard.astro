---
import { TAG_STYLES, type NewsItem } from "@/lib/news"

interface Props {
  item: NewsItem
  date: string
  compact?: boolean
}
const { item, date, compact = false } = Astro.props
const permalink = `/noticias/${date}/${item.slug}`
---

<article data-tag={item.tag} class="reveal spotlight group relative flex flex-col rounded-2xl border border-line/10 bg-surface/60 p-6 transition hover:border-line/25">
  <div class="flex items-center gap-3 text-xs">
    <span class={`rounded-md px-2 py-0.5 font-mono font-medium ${TAG_STYLES[item.tag] ?? "bg-line/5 text-muted"}`}>{item.tag}</span>
    <span class="text-muted">{item.source}</span>
  </div>
  <h3 class:list={["mt-3 font-semibold leading-snug tracking-tight", compact ? "text-lg" : "text-xl"]}>
    <a href={permalink} class="after:absolute after:inset-0">{item.title}</a>
  </h3>
  <p class:list={["mt-3 leading-relaxed text-muted", compact && "line-clamp-3"]}>{item.summary}</p>
  {
    !compact && (
      <p class="mt-4 border-l-2 border-accent/60 pl-3 text-[15px] leading-relaxed">
        <span class="font-mono text-[11px] uppercase tracking-wider text-accent">Por qué importa · </span>
        {item.take}
      </p>
    )
  }
  <div class="relative z-10 mt-auto flex items-center gap-4 pt-5 text-sm">
    <a href={permalink} class="font-medium text-fg underline decoration-line/20 underline-offset-4 hover:decoration-accent">Comentar</a>
    <a href={item.url} target="_blank" rel="noopener noreferrer" class="text-muted hover:text-fg">Leer en {item.source.split(" · ")[0]} ↗</a>
  </div>
</article>
