---
import { content, getLang } from "@/i18n"
const lang = getLang(Astro.url)
const en = lang === "en"
const { PROJECTS, PROFILE } = content(lang)
---

<div class="grid gap-5 md:grid-cols-2">
  {
    PROJECTS.map((p, i) => (
      <article
        class:list={[
          "reveal spotlight group flex flex-col overflow-hidden rounded-2xl border border-line/10 bg-surface/60 transition-colors hover:border-line/25",
          p.featured && "md:col-span-2 md:flex-row",
        ]}
        data-tilt
      >
        <div class:list={["relative overflow-hidden border-line/10 bg-bg", p.featured ? "md:w-3/5 md:border-r" : "border-b"]}>
          <img
            src={p.image}
            alt={en ? `Screenshot of ${p.title}` : `Captura del proyecto ${p.title}`}
            loading="lazy"
            decoding="async"
            class:list={[
              "w-full object-cover object-top transition duration-700 group-hover:scale-[1.03]",
              p.featured ? "aspect-[16/10] md:h-full" : "aspect-[16/9]",
            ]}
          />
          {p.featured && (
            <span class="absolute left-4 top-4 rounded-full bg-bg/80 px-2.5 py-1 font-mono text-[11px] uppercase tracking-wider text-accent backdrop-blur">
              {en ? "Featured" : "Destacado"}
            </span>
          )}
        </div>
        <div class:list={["flex flex-1 flex-col p-6", p.featured && "md:justify-center md:p-8"]}>
          <h3 class:list={["font-semibold tracking-tight", p.featured ? "text-2xl" : "text-xl"]}>{p.title}</h3>
          <p class="mt-3 leading-relaxed text-muted">{p.description}</p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {p.tags.map((t) => (
              <li class="rounded-md border border-line/10 bg-bg px-2 py-1 font-mono text-xs text-muted">{t}</li>
            ))}
          </ul>
          <div class="mt-auto flex gap-2 pt-6">
            {p.link && (
              <a
                href={p.link}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-lg bg-fg px-3 py-2 text-sm font-medium text-bg transition hover:bg-accent hover:text-accent-fg"
              >
                {en ? "Live demo" : "Ver demo"}
                <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
              </a>
            )}
            {p.github && (
              <a
                href={p.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-lg border border-line/15 px-3 py-2 text-sm font-medium transition hover:bg-line/5"
              >
                {en ? "Code" : "Código"}
              </a>
            )}
          </div>
        </div>
      </article>
    ))
  }
</div>

<div class="mt-10 text-center">
  <a href={PROFILE.github} target="_blank" rel="noopener noreferrer" class="font-mono text-sm text-muted underline decoration-line/20 underline-offset-4 transition hover:text-fg hover:decoration-accent">
    {en ? "More projects on github.com/gerysx →" : "Más proyectos en github.com/gerysx →"}
  </a>
</div>
