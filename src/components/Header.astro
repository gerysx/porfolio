---
import ThemeToggle from "./ThemeToggle.astro"

const NAV = [
  { title: "Experiencia", id: "experiencia" },
  { title: "Arquitectura", id: "arquitectura" },
  { title: "Stack", id: "stack" },
  { title: "Proyectos", id: "proyectos" },
  { title: "Sobre mí", id: "sobre-mi" },
  { title: "Noticias", id: "noticias", href: "/noticias" },
]
---

<header class="fixed inset-x-0 top-0 z-40 flex justify-center px-4 pt-3">
  <nav
    aria-label="Principal"
    class="flex w-full max-w-5xl items-center justify-between gap-2 rounded-2xl border border-line/10 bg-bg/70 px-3 py-2 shadow-[0_8px_30px_rgb(0_0_0/0.08)] backdrop-blur-xl"
  >
    <a href="/#inicio" class="group flex items-center gap-2 rounded-lg px-1 font-mono text-sm" aria-label="Inicio">
      <span class="grid size-8 place-items-center rounded-lg bg-fg font-sans text-sm font-bold text-bg transition group-hover:bg-accent group-hover:text-accent-fg">GÁ</span>
      <span class="hidden text-muted sm:inline">gerysdev<span class="text-accent">.es</span></span>
    </a>

    <ul class="hidden items-center gap-1 whitespace-nowrap text-sm lg:flex">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href ?? `/#${item.id}`}
              data-nav={item.id}
              class="rounded-lg px-3 py-1.5 text-muted transition hover:bg-line/5 hover:text-fg data-[active=true]:text-fg"
            >
              {item.title}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1">
      <button
        type="button"
        data-open-palette
        class="flex items-center gap-2 rounded-lg border border-line/10 px-2.5 py-1.5 text-sm text-muted transition hover:border-line/25 hover:text-fg"
        aria-label="Abrir paleta de comandos"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <span class="hidden sm:inline">Buscar</span>
        <kbd class="hidden rounded border border-line/15 px-1.5 font-mono text-[11px] sm:inline">⌘K</kbd>
      </button>
      <ThemeToggle />
      <a
        href="/#contacto"
        class="ml-1 hidden rounded-lg bg-fg px-3 py-1.5 text-sm font-medium text-bg transition hover:bg-accent hover:text-accent-fg sm:inline-block"
        >Contacto</a
      >
    </div>
  </nav>
</header>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav]")
  const sections = [...links]
    .map((l) => document.getElementById(l.dataset.nav!))
    .filter(Boolean) as HTMLElement[]
  const obs = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue
        links.forEach((l) => (l.dataset.active = String(l.dataset.nav === e.target.id)))
      }
    },
    { rootMargin: "-45% 0px -50% 0px" }
  )
  sections.forEach((s) => obs.observe(s))
</script>
