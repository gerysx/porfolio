---
import Banner from "@/components/Banner.astro"
import { content, getLang, homePath } from "@/i18n"

const lang = getLang(Astro.url)
const en = lang === "en"
const { PROFILE } = content(lang)

const json = [
  ["name", `"${PROFILE.name}"`],
  ["role", `"${PROFILE.role}"`],
  ["company", `"${PROFILE.company}"`],
  ["sector", en ? `"international banking"` : `"banca internacional"`],
  ["location", `"Madrid, ES"`],
  ["focus", en ? `["architecture", "integration", "cloud", "delivery"]` : `["arquitectura", "integración", "cloud", "delivery"]`],
  ["patterns", en ? `["microservices", "event-driven", "api-first"]` : `["microservicios", "event-driven", "api-first"]`],
  ["platform", en ? `["kubernetes", "ci/cd", "observability"]` : `["kubernetes", "ci/cd", "observabilidad"]`],
  ["status", `"building"`],
]
---

<section id="inicio" class="mx-auto w-full max-w-5xl scroll-mt-24 px-4 pb-16 pt-24 md:pb-24 md:pt-28">
  <div class="relative">
    <div data-hero-banner><Banner /></div>
    <img
      src="/projects/german-render.webp"
      alt=""
      aria-hidden="true"
      data-hero-avatar
      class="absolute -bottom-10 left-4 size-24 rounded-full border-4 border-bg bg-gradient-to-b from-[#0a1f63] to-[#050816] object-cover object-top shadow-xl sm:left-10 sm:size-32 md:-bottom-14 md:size-36"
    />
  </div>
  <div class="mt-20 grid items-center gap-12 md:mt-24 md:grid-cols-[1.15fr_1fr]">
  <div>
    <p data-hero-item class="font-mono text-xs uppercase tracking-[0.2em] text-accent">{en ? "International banking · Architecture · Cloud · Delivery" : "Banca internacional · Arquitectura · Cloud · Delivery"}</p>
    {en ? (<>
      <p data-hero-item class="mt-4 text-4xl font-semibold leading-[1.05] tracking-[-0.035em] sm:text-5xl md:text-[3.4rem]">
        Software architecture, <span class="text-gradient">end to end.</span>
      </p>
      <p data-hero-item class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
        {PROFILE.tagline} From <span class="text-fg">system design</span> and its contracts to
        <span class="text-fg">event-driven integration</span>, <span class="text-fg">Kubernetes deployments</span>
        and observability in production.
      </p>
    </>) : (<>
      <p data-hero-item class="mt-4 text-4xl font-semibold leading-[1.05] tracking-[-0.035em] sm:text-5xl md:text-[3.4rem]">
        Arquitectura de software <span class="text-gradient">de extremo a extremo.</span>
      </p>
      <p data-hero-item class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
        {PROFILE.tagline} Del <span class="text-fg">diseño del sistema</span> y sus contratos a la
        <span class="text-fg">integración por eventos</span>, el <span class="text-fg">despliegue en Kubernetes</span>
        y la observabilidad en producción.
      </p>
    </>)}

    <div data-hero-item class="mt-9 flex flex-wrap gap-3">
      <a
        href={`${homePath(lang)}#contacto`}
        data-magnetic
        class="inline-flex items-center gap-2 rounded-xl bg-fg px-5 py-3 text-sm font-medium text-bg transition hover:bg-accent hover:text-accent-fg"
      >
        {en ? "Let's talk" : "Hablemos"}
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
      <a
        href={PROFILE.cv}
        download
        data-magnetic
        class="inline-flex items-center gap-2 rounded-xl border border-line/15 px-5 py-3 text-sm font-medium transition hover:border-line/30 hover:bg-line/5"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path></svg>
        {en ? "Download CV" : "Descargar CV"}
      </a>
      <div class="flex items-center gap-1">
        <a href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="grid size-11 place-items-center rounded-xl text-muted transition hover:bg-line/5 hover:text-fg">
          <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"></path></svg>
        </a>
        <a href={PROFILE.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="grid size-11 place-items-center rounded-xl text-muted transition hover:bg-line/5 hover:text-fg">
          <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8 0 3.2.9.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1 .9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3"></path></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Terminal: "respuesta" de la API -->
  <div class="relative [perspective:1000px]" data-hero-terminal>
    <div class="absolute -inset-4 -z-10 rounded-[28px] bg-gradient-to-br from-accent/20 via-transparent to-transparent blur-2xl"></div>
    <div class="overflow-hidden rounded-2xl border border-line/10 bg-surface shadow-2xl shadow-black/20">
      <div class="flex items-center gap-2 border-b border-line/10 px-4 py-3">
        <span class="size-3 rounded-full bg-[#ff5f57]"></span>
        <span class="size-3 rounded-full bg-[#febc2e]"></span>
        <span class="size-3 rounded-full bg-[#28c840]"></span>
        <span class="ml-3 truncate font-mono text-xs text-muted">~ curl gerysdev.es/api/v1/german</span>
      </div>
      <div class="p-5 font-mono text-[12.5px] leading-6 sm:text-[13px]">
        <p class="text-muted">
          <span class="text-emerald-500">HTTP/1.1 200 OK</span> · <span>application/json</span> · <span class="text-accent">12ms</span>
        </p>
        <pre class="mt-3 whitespace-pre-wrap break-words" data-typed><span class="text-muted">{"{"}</span>
{json.map(([k, v], i) => (
  <span class="typed-line block pl-4" style={`--d:${i * 140}ms`}><span class="text-sky-600 dark:text-sky-300">"{k}"</span><span class="text-muted">: </span><span class="text-fg">{v}</span><span class="text-muted">{i < json.length - 1 ? "," : ""}</span></span>
))}<span class="text-muted">{"}"}</span><span class="ml-1 inline-block h-4 w-2 translate-y-0.5 animate-blink bg-accent"></span></pre>
      </div>
    </div>
  </div>
  </div>
</section>

<style>
  .typed-line {
    opacity: 0;
    transform: translateX(-6px);
    animation: line-in 0.4s ease forwards;
    animation-delay: calc(var(--d) + 300ms);
  }
  @keyframes line-in {
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .typed-line { animation: none; opacity: 1; transform: none; }
  }
</style>
