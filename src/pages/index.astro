---
import Layout from "@/layouts/Layout.astro"
import Hero from "@/components/Hero.astro"
import Game from "@/components/Game.astro"
import Highlights from "@/components/Highlights.astro"
import Section from "@/components/Section.astro"
import Experience from "@/components/Experience.astro"
import Architecture from "@/components/Architecture.astro"
import Stack from "@/components/Stack.astro"
import Projects from "@/components/Projects.astro"
import About from "@/components/About.astro"
import Contact from "@/components/Contact.astro"
import NewsTeaser from "@/components/NewsTeaser.astro"
---

<Layout>
  <Hero />
  <Game />
  <Highlights />

  <Section
    id="experiencia"
    index="01"
    eyebrow="Experiencia"
    title="De construir sistemas a <span class='text-gradient'>diseñarlos</span>."
    intro="Del desarrollo en banca internacional al diseño de soluciones enterprise completas en NTT DATA: arquitectura, integración, despliegue y operación."
  >
    <Experience />
  </Section>

  <Section
    id="arquitectura"
    index="02"
    eyebrow="Cómo construyo"
    title="Así viaja una petición por los sistemas que diseño."
    intro="Pulsa cada pieza para ver qué decisión hay detrás. Debajo, las puertas de calidad por las que pasa cada cambio antes de llegar a producción."
  >
    <Architecture />
  </Section>

  <Section id="stack" index="03" eyebrow="Stack" title="Arquitectura, integración y <span class='text-gradient'>despliegue</span>."
    intro="Patrones, plataformas y herramientas con las que diseño, integro y llevo a producción sistemas enterprise.">
    <Stack />
  </Section>

  <Section
    id="proyectos"
    index="04"
    eyebrow="Proyectos"
    title="Cosas que he construido por mi cuenta."
    intro="Proyectos personales full stack, con demo en vivo y código abierto."
  >
    <Projects />
  </Section>

  <Section id="sobre-mi" index="05" eyebrow="Sobre mí" title="Más allá del <span class='text-gradient'>CV</span>.">
    <About />
  </Section>

  <Section
    id="noticias"
    index="06"
    eyebrow="Noticias"
    title="Hoy en <span class='text-gradient'>tecnología</span>."
    intro="Cada mañana selecciono 4-5 noticias de backend, cloud, IA y seguridad con un comentario de por qué importan."
  >
    <NewsTeaser />
  </Section>

  <Contact />
</Layout>
