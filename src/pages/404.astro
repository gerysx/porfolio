---
import Layout from "@/layouts/Layout.astro"
---

<Layout title="404 · Página no encontrada" description="La página que buscas no existe.">
  <section class="mx-auto flex min-h-[70vh] max-w-xl flex-col items-center justify-center px-4 text-center">
    <p class="font-mono text-sm text-muted"><span class="text-red-500">HTTP/1.1 404</span> Not Found</p>
    <h1 class="mt-4 text-5xl font-semibold tracking-tight">Este endpoint <span class="text-gradient">no existe</span>.</h1>
    <p class="mt-4 text-muted">Puede que el enlace esté roto o que la página se haya movido.</p>
    <a href="/" class="mt-8 rounded-xl bg-fg px-5 py-3 text-sm font-medium text-bg transition hover:bg-accent hover:text-accent-fg">Volver al inicio</a>
  </section>
</Layout>
