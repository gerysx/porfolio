---
import "@fontsource-variable/onest"
import "@/styles/global.css"

import Header from "@/components/Header.astro"
import Footer from "@/components/Footer.astro"
import CommandPalette from "@/components/CommandPalette.astro"
import { PROFILE } from "@/data/profile"

interface Props {
  title?: string
  description?: string
}

const {
  title = `${PROFILE.name} · ${PROFILE.role}`,
  description = PROFILE.summary,
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site ?? PROFILE.site).href
const ogImage = new URL("/og.png", Astro.site ?? PROFILE.site).href

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: PROFILE.fullName,
  jobTitle: PROFILE.role,
  worksFor: { "@type": "Organization", name: PROFILE.company },
  address: { "@type": "PostalAddress", addressLocality: "Madrid", addressCountry: "ES" },
  url: PROFILE.site,
  sameAs: [PROFILE.linkedin, PROFILE.github],
}
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#08090c" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      try {
        const t = localStorage.getItem("theme")
        if (t === "light") document.documentElement.classList.remove("dark")
      } catch (_) {}
    </script>
  </head>

  <body class="min-h-screen overflow-x-hidden">
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10">
      <div class="bg-grid absolute inset-0"></div>
      <div class="absolute -top-40 left-1/2 h-[480px] w-[900px] max-w-[160vw] -translate-x-1/2 rounded-full bg-accent/10 blur-[120px]"></div>
    </div>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-3 focus:py-2 focus:text-accent-fg">
      Saltar al contenido
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CommandPalette />

    <script>
      // Aparición al hacer scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible")
              io.unobserve(e.target)
            }
          }
        },
        { threshold: 0.12 }
      )
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el))

      // Foco que sigue al cursor en tarjetas
      document.querySelectorAll<HTMLElement>(".spotlight").forEach((el) => {
        el.addEventListener("pointermove", (ev) => {
          const r = el.getBoundingClientRect()
          el.style.setProperty("--mx", `${ev.clientX - r.left}px`)
          el.style.setProperty("--my", `${ev.clientY - r.top}px`)
        })
      })
    </script>
  </body>
</html>
